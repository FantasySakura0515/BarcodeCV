# Copy this file to .env.local and fill in your values.
#
# REQUIRED when Next.js is NOT running on the same machine as the backend
# (e.g. you access the frontend from a PC while the backend runs on Pi).
#
# Set this to the Pi's address:
#   BACKEND_API_BASE_URL=http://192.168.1.100:8000/api
#
# If both frontend AND backend run on the same machine (e.g. both on Pi),
# leave this commented out — the default (127.0.0.1:8000) will work.
#
BACKEND_API_BASE_URL=http://127.0.0.1:8000/api

# Used by the browser-side client to reach the backend images.
# Should match the Pi's IP when frontend is on a different machine.
# NEXT_PUBLIC_BACKEND_ORIGIN=http://192.168.1.100:8000
